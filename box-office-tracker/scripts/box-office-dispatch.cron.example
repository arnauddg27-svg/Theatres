# Example VPS cron for the Box Office Pipeline.
# Install as /etc/cron.d/box-office-dispatch after setting REPO_DIR, GH_REPO,
# and GH_TOKEN_FILE. The live VPS should run this tracked dispatcher instead
# of any legacy /root/box-office-dispatch/dispatch.sh schedule.
#
# These times are UTC. They intentionally omit Mountain Time.
# Snapshot probes use a separate workflow concurrency lane and force=true so they
# collect pre-reservation rows without blocking or being blocked by same-day
# scrape dedup.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
REPO_DIR=/opt/box-office-tracker
GH_REPO=arnauddg27-svg/Theatres
GH_TOKEN_FILE=/root/box-office-dispatch/.env
# /etc/cron.d variable assignments do not expand other variables, so keep this
# path absolute instead of using $REPO_DIR here.
DISPATCH=/opt/box-office-tracker/box-office-tracker/scripts/dispatch_box_office_pipeline.sh

# Phase 1 weekly warm-cache. Tuesday full-weekend mode targets the upcoming
# Thu-Sun opening weekend, not the prior weekend. These staggered passes give
# the system a full day to collect broad future links; duplicate later passes
# skip automatically after a successful same-day collect-links commit.
# Dispatcher mode: collect-links -> phase=collect-links
0 13 * * 2 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links ET >> /var/log/box-office-dispatch.log 2>&1
0 15 * * 2 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links CT >> /var/log/box-office-dispatch.log 2>&1
0 17 * * 2 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links PT >> /var/log/box-office-dispatch.log 2>&1
0 19 * * 2 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links ET >> /var/log/box-office-dispatch.log 2>&1
0 21 * * 2 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links CT >> /var/log/box-office-dispatch.log 2>&1
0 23 * * 2 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links PT >> /var/log/box-office-dispatch.log 2>&1

# Rolling pre-reservation snapshot probe using Tuesday's committed Phase 1 cache.
# Each run captures the remaining opening weekend for the capped top-theatre
# sample. If a capped theatre/date slice is missing links, the workflow may try
# a targeted repair for that slice, but it does not run a broad Phase 1 rebuild.
# The UTC day 4 slot is Wednesday evening local time for all ET/CT/PT groups.
# Dispatcher mode: snapshot -> phase=scrape, pre_reservation_snapshots=true, snapshots_only=true
30 2 * * 0,1,4,5,6 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" snapshot >> /var/log/box-office-dispatch.log 2>&1

# Model-driving post-show scrape. Keep this clear of snapshot probes.
# Dispatcher mode: scrape -> phase=scrape, snapshots_only=false
0 7 * * 0,1,5,6 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" scrape >> /var/log/box-office-dispatch.log 2>&1

# Weekly calibration after Tuesday actuals have had time to post, outside the
# Tuesday Phase 1 warm-cache day.
0 12 * * 3 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" calibrate >> /var/log/box-office-dispatch.log 2>&1
