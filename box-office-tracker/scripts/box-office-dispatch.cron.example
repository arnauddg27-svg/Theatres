# VPS watchdog cron fallback for the Box Office Pipeline.
#
# Primary scheduling lives in .github/workflows/box-office-scheduler.yml and
# uses GitHub's short-lived workflow token. This VPS watchdog is intentionally
# not the old blind cron: it checks recent GitHub Actions runs first and only
# dispatches a slot after the primary scheduler missed it past the grace window.
#
# These times are UTC. They intentionally omit Mountain Time.
# Snapshot probes use a separate workflow concurrency lane and force=true so they
# collect pre-reservation rows without blocking or being blocked by same-day
# scrape dedup.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
REPO_DIR=/opt/box-office-tracker
GH_REPO=arnauddg27-svg/Theatres
GH_TOKEN_FILE=/root/box-office-dispatch/.env
# /etc/cron.d variable assignments do not expand other variables, so keep this
# path absolute instead of using $REPO_DIR here.
DISPATCH=/opt/box-office-tracker/box-office-tracker/scripts/dispatch_box_office_pipeline.sh
WATCHDOG=/opt/box-office-tracker/box-office-tracker/scripts/schedule_box_office_pipeline.py

# Watchdog fallback. Runs ten minutes after each GitHub scheduler tick, checks the last four hours of
# expected slots, and dispatches only slots older than 30 minutes with no recent
# matching workflow run. Snapshot slots use the shorter grace so a missed 02:30Z
# primary dispatch is recovered before the ET local date rolls forward. The
# :10/:40 offset avoids racing GitHub's primary scheduler at :00/:30.
10,40 * * * * root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && set -a && . "$GH_TOKEN_FILE" && set +a && python3 "$WATCHDOG" --mode watchdog --repo "$GH_REPO" --workflow box-office-pipeline.yml --ref main --lookback-minutes 240 --fallback-grace-minutes 30 --token-env GH_TOKEN >> /var/log/box-office-dispatch.log 2>&1

# Phase 1 weekly warm-cache. Tuesday full-weekend mode targets the upcoming
# Thu-Sun opening weekend, not the prior weekend. Wednesday repeats are fallback
# passes: the dedup guard looks back to Tuesday on Wednesdays and skips any TZ
# whose Tuesday run committed canonical showtime links. This covers the case
# where Polymarket has not exposed the upcoming market yet on Tuesday.
# Legacy direct dispatcher examples. Do not uncomment unless the watchdog has
# been intentionally disabled.
# Dispatcher mode: collect-links -> phase=collect-links
# 0 13 * * 2,3 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links ET >> /var/log/box-office-dispatch.log 2>&1
# 0 15 * * 2,3 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links CT >> /var/log/box-office-dispatch.log 2>&1
# 0 17 * * 2,3 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links PT >> /var/log/box-office-dispatch.log 2>&1
# 0 19 * * 2,3 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links ET >> /var/log/box-office-dispatch.log 2>&1
# 0 21 * * 2,3 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links CT >> /var/log/box-office-dispatch.log 2>&1
# 0 23 * * 2,3 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" collect-links PT >> /var/log/box-office-dispatch.log 2>&1

# Rolling pre-reservation snapshot probe using Tuesday's committed Phase 1 cache.
# Each run captures the remaining opening weekend for the capped top-theatre
# sample. If a capped theatre/date slice is missing links, the workflow may try
# a targeted repair for that slice, but it does not run a broad Phase 1 rebuild.
# The UTC day 4 slot is Wednesday evening local time for all ET/CT/PT groups.
# UTC day 0 is Saturday evening local time; UTC day 1 is intentionally omitted
# because it would run Sunday evening local time, shortly before the regular
# post-Sunday scrape.
# Dispatcher mode: snapshot -> phase=scrape, pre_reservation_snapshots=true, snapshots_only=true
# 30 2 * * 0,4,5,6 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" snapshot >> /var/log/box-office-dispatch.log 2>&1

# Model-driving post-show scrape. Keep this clear of snapshot probes.
# Dispatcher mode: scrape -> phase=scrape, snapshots_only=false
# 0 7 * * 0,1,5,6 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" scrape >> /var/log/box-office-dispatch.log 2>&1

# Weekly calibration after Tuesday actuals have had time to post, outside the
# Tuesday Phase 1 warm-cache day.
# 0 12 * * 3 root cd "$REPO_DIR" && git -C "$REPO_DIR" pull --ff-only origin main && GH_TOKEN_FILE="$GH_TOKEN_FILE" GH_REPO="$GH_REPO" "$DISPATCH" calibrate >> /var/log/box-office-dispatch.log 2>&1
